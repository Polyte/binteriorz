{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "binteriorz",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "vars": {
    "PAYFAST_MODE": "live"
  },
  "kv_namespaces": [
    { "binding": "PAYFAST_ORDERS", "id": "d962688425914149854bc0a77413cf98" }
  ],
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "binteriorz-db",
      "database_id": "5b23e141-fa97-44c8-875d-f2aee67115e4",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "APP_MEDIA", "bucket_name": "binteriorz-media" }
  ]
}
