# Fingerprinted build output: the file name changes whenever the content does.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Catalogue and site photography: cache for a month, refresh quietly in the background.
/product-images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800

/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800

/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

# The HTML shell must always be revalidated so new deploys show up immediately.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate
